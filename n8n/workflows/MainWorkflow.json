    {
      "parameters": {
        "jsCode": "const state = $input.first().json;\nconst now = new Date();\n\nconst locations = {\n  \"LOC_001\": \"This is Room 2010. You can find 2 office rooms for 2 professors here. Professor Caroline Clevenger and Professor Moatassem Abdallah. Caroline teaches Construction Planning and Control. Moatassem teaches Building Information Modeling\",\n  \"LOC_002\": \"Hallway near elevators\",\n  \"LOC_003\": \"Charging station\",\n  \"LOC_004\": \"Whiteboard area\"\n};\n\nconst locationId = state.location;\nconst locationDescription = locations[locationId] || locationId || 'Unknown';\n\nconst faces = Array.isArray(state.faces) ? state.faces : [];\nconst primaryFace = faces.length > 0 ? faces[0] : null;\nconst confidence = primaryFace ? (primaryFace.confidence || 0) : 0;\nconst name = primaryFace ? (primaryFace.name || 'unknown') : 'unknown';\n\nlet retrieval_hint = '';\nif (confidence >= 0.80) {\n  retrieval_hint = `Verified user: ${name}. Looking up personalized information for ${name}.`;\n} else if (confidence >= 0.65) {\n  retrieval_hint = `Identity verification in progress for unconfirmed visitor (confidence ${confidence.toFixed(2)}). Checking access policy for users pending identity confirmation and testing access authorization procedures.`;\n} else {\n  retrieval_hint = `Unknown visitor, no identity match. Standard guest access policy applies.`;\n}\n\nreturn {\n  ...state,\n  location: locationDescription,\n  current_time: now.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }),\n  day_of_week: now.toLocaleDateString('en-US', { weekday: 'long' }),\n  date: now.toLocaleDateString('en-US'),\n  retrieval_hint: retrieval_hint,\n  identity_confidence: confidence\n};"
      },
